# ==============================================================================
# G-MAPS INDUSTRIAL INTELLIGENCE - FULL-STACK AI LEAD AUTOMATION PLATFORM
# ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' in the project root or server folder.
# NEVER commit your production '.env' with real secrets into version control.
# ==============================================================================

# --- SERVER RUNTIME ---
PORT=3001
NODE_ENV=production

# --- SAFETY GUARDS & KILL SWITCHES ---
# Setting this to 'true' immediately halts all outbound production emails & WhatsApp messages
GLOBAL_OUTREACH_KILL_SWITCH=false
# Per-channel toggles
EMAIL_OUTREACH_ENABLED=true
WHATSAPP_OUTREACH_ENABLED=true

# --- DEDICATED TEST LAB ISOLATION ---
# Test sends in the Test Lab module are strictly restricted to these verified allowlisted destinations
TEST_ALLOWLIST_EMAIL=your-verified-email@company.com
TEST_ALLOWLIST_PHONE=+919876543210

# --- AI CONVERSATION ENGINE (GOOGLE GEMINI API) ---
# Acquire from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# --- PRODUCTION EMAIL PROVIDER (SMTP / IMAP / API) ---
# Configure your company mailbox (Google Workspace, Microsoft 365, GoDaddy, or SendGrid/Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-company-sender@company.com
SMTP_PASS=your-secure-app-password
SMTP_FROM="G-MAPS Industrial" <your-company-sender@company.com>

# --- OFFICIAL META WHATSAPP BUSINESS PLATFORM CLOUD API ---
# Acquire from Meta Developers Portal (https://developers.facebook.com/)
# 1. System User Permanent Access Token with whatsapp_business_messaging & whatsapp_business_management
META_WA_ACCESS_TOKEN=your-meta-cloud-api-access-token
# 2. WhatsApp Business Phone Number ID (from WhatsApp > API Setup)
META_WA_PHONE_NUMBER_ID=your-phone-number-id
# 3. WhatsApp Business Account ID (WABA ID)
META_WA_BUSINESS_ACCOUNT_ID=your-waba-id
# 4. Webhook Verification Token (custom random secret string configured in Meta Webhooks)
META_WA_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verification-token

# --- GOOGLE PLACES API (NEW) ---
# Acquire from Google Cloud Console with 'Places API (New)' enabled
GOOGLE_PLACES_API_KEY=your-google-places-api-key
